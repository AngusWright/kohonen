Package: kohonen
Version: 3.0.13
Title: Supervised and Unsupervised Self-Organising Maps
Authors@R: c(person(given = "Ron",
                      family = "Wehrens",
                      role = c("aut", "cre"),
                      email = "ron.wehrens@gmail.com"),
               person(given = "Johannes",
                      family = "Kruisselbrink",
                      role = "aut"), 
               person(given = "Angus",
